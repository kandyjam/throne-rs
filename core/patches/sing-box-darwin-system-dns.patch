+// The owner retains static DNS before redirecting the system resolver. DHCP is
+// consulted only for services that originally had no explicit DNS servers.
+// An inaccessible ownership record cannot establish that DHCP is appropriate.
+func (s *Source) replaceManagedServers(config *Config, interfaceIndex int) bool {
+	if s.dnsOverride == nil {
+		return false
+	}
+	iface, err := net.InterfaceByIndex(interfaceIndex)
+	if err != nil {
+		// Without a device, saved DNS cannot be trusted or DHCP queried. The
+		// provider can still identify its alias for conservative exclusion.
+		alias, _, _ := s.dnsOverride.SystemDNSOverride("")
+		return replaceManagedDNS(config, alias, nil, false, nil)
+	}
+	alias, saved, known := s.dnsOverride.SystemDNSOverride(iface.Name)
+	return replaceManagedDNS(config, alias, saved, known, func() []M.Socksaddr { return leaseServers(iface.Name) })
+}
+
+func replaceManagedDNS(config *Config, alias string, saved []string, known bool, lease func() []M.Socksaddr) bool {
+	address, err := netip.ParseAddr(alias)
+	if err != nil {
+		return false
+	}
+	found := false
+	for _, server := range config.Servers {
+		if server.Addr.Unmap() == address.Unmap() {
+			found = true
+			break
+		}
+	}
+	if !found {
+		return false
+	}
+	var servers []M.Socksaddr
+	if known {
+		for _, value := range saved {
+			if parsed, err := netip.ParseAddr(value); err == nil && parsed.Unmap() != address.Unmap() {
+				servers = append(servers, M.SocksaddrFrom(parsed, 53))
+			}
+		}
+		if len(saved) == 0 {
+			servers = lease()
+		}
+	}
+	// Unknown saved DNS and unavailable DHCP leases must fail closed rather than
+	// resolve through our listener; retain independent resolvers in their order.
+	var replacement []M.Socksaddr
+	for _, server := range config.Servers {
+		if server.Addr.Unmap() == address.Unmap() {
+			for _, upstream := range servers {
+				if upstream.Addr.IsValid() && upstream.Addr.Unmap() != address.Unmap() {
+					replacement = append(replacement, upstream)
+				}
+			}
+		} else {
+			replacement = append(replacement, server)
+		}
+	}
+	config.Servers = replacement
+	return true
+}
