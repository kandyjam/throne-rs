# Rust
/target/
**/*.rs.bk

# Packaging output
/dist/
*.dmg
*.deb
*.rpm
*.AppImage
*.msi
# (*.exe already ignored below)

# Go core build artifacts (binary names — not the core/ source tree)
/deployment/
# Note: never ignore `Core` or `core` without an extension. On a
# case-insensitive volume that pattern hides the vendored `core/` tree.
**/ThroneCore
**/nekobox_core
**/nekobox_core.exe
**/Core.exe
*.exe
*.dll
*.so
*.dylib

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Agent / local indexes (not source)
.codegraph/
.code-review-graph/
.tokensave/
codedb.snapshot
*.snapshot

# Env / secrets
.env
.env.*

# CMake / legacy (if reintroduced)
/build/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
