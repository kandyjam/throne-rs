#!/usr/bin/env bash
# Build ThroneCore (Go) for the host and place it next to the GUI binary.
# Usage: ./script/build-core [output-directory [binary-name]]
# Requires: go 1.26+, protoc, protoc-gen-go, protoc-gen-go-grpc
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CORE_DIR="$ROOT/core"
OUT_DIR="${1:-$ROOT/target/debug}"
OUT_NAME="${2:-ThroneCore}"
GO_BIN="${GO_BIN:-go}"

# Prefer a reachable module proxy (proxy.golang.org often times out in CN).
export GOPROXY="${GOPROXY:-https://goproxy.cn,https://proxy.golang.org,direct}"

if ! command -v "$GO_BIN" >/dev/null 2>&1; then
  echo "error: go not found — install Go 1.26+ (brew install go)" >&2
  exit 1
fi
GO_PLUGIN_DIR="$("$GO_BIN" env GOBIN)"
if [[ -z "$GO_PLUGIN_DIR" ]]; then
  GO_PLUGIN_DIR="$("$GO_BIN" env GOPATH)"
  GO_PLUGIN_DIR="${GO_PLUGIN_DIR%%:*}/bin"
fi
export PATH="${PATH}:${GO_PLUGIN_DIR}:${HOME}/go/bin:/opt/homebrew/bin"
if ! command -v protoc >/dev/null 2>&1; then
  echo "error: protoc not found — brew install protobuf" >&2
  exit 1
fi

# Ensure plugins
if ! command -v protoc-gen-go >/dev/null 2>&1; then
  "$GO_BIN" install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.11
fi
if ! command -v protoc-gen-go-grpc >/dev/null 2>&1; then
  "$GO_BIN" install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2
fi

echo "==> generating gen/ from libcore.proto"
(
  cd "$CORE_DIR/gen"
  protoc --go_out=. --go-grpc_out=. \
    --go_opt=paths=source_relative \
    --go-grpc_opt=paths=source_relative \
    libcore.proto
)

# Match upstream throneproj/Throne `script/build_go.sh` (tag 1.4.0-beta.4, module root `core/`).
# Base tags + platform extras. Override with THRONE_CORE_TAGS=...
if [[ -n "${THRONE_CORE_TAGS:-}" ]]; then
  TAGS="$THRONE_CORE_TAGS"
else
  TAGS="with_clash_api,with_quic,with_wireguard,with_utls,with_dhcp,with_tailscale,with_openvpn,with_openconnect,badlinkname,tfogo_checklinkname0"
  case "$(uname -s)" in
    Darwin|Linux) TAGS+=",with_naive_outbound" ;;
  esac
fi

mkdir -p "$OUT_DIR"
OUT_DIR="$(cd "$OUT_DIR" && pwd)"
OUT_BIN="$OUT_DIR/$OUT_NAME"
echo "==> building ThroneCore → $OUT_BIN"
echo "    tags: $TAGS"
(
  cd "$CORE_DIR"
  if [[ "$(uname -s)" == "Darwin" && ",$TAGS," == *,with_naive_outbound,* ]]; then
    # The cgo link cannot detect a cronet binding/library ABI mismatch.
    CRONET_LIB="github.com/sagernet/cronet-go/lib/darwin_$("$GO_BIN" env GOARCH)"
    "$GO_BIN" mod download github.com/sagernet/cronet-go "$CRONET_LIB"
    CRONET_LIB_INCLUDE="$("$GO_BIN" list -m -f '{{.Dir}}' "$CRONET_LIB")/include"
    for header in "$("$GO_BIN" list -m -f '{{.Dir}}' github.com/sagernet/cronet-go)"/include/*.h; do
      if ! cmp -s "$header" "$CRONET_LIB_INCLUDE/${header##*/}"; then
        echo "error: cronet-go binding and $CRONET_LIB differ in ${header##*/}" >&2
        exit 1
      fi
    done
  fi
  # Apply the pinned REALITY compatibility fix to a private dependency copy.
  # Never modify GOMODCACHE: other projects and unpatched builds share it.
  export GOWORK=off
  VERSION_SINGBOX="$("$GO_BIN" list -m -f '{{.Version}}' github.com/sagernet/sing-box)"
  SINGBOX_REPLACE="$("$GO_BIN" list -m -f '{{with .Replace}}{{.Path}} {{.Version}}{{end}}' github.com/sagernet/sing-box)"
  EXPECTED_SINGBOX="github.com/throneproj/sing-box v1.11.16-0.20261019002151-a29d468286bc"
  if [[ "$SINGBOX_REPLACE" != "$EXPECTED_SINGBOX" ]]; then
    echo "error: re-audit core/patches/sing-box-reality-mlkem.patch for $SINGBOX_REPLACE" >&2
    exit 1
  fi
  "$GO_BIN" mod download github.com/sagernet/sing-box
  SINGBOX_SOURCE="$("$GO_BIN" list -m -f '{{.Dir}}' github.com/sagernet/sing-box)"
  if [[ -z "$SINGBOX_SOURCE" || ! -f "$SINGBOX_SOURCE/common/tls/reality_client.go" ]]; then
    echo "error: pinned sing-box source is unavailable after download" >&2
    exit 1
  fi
  if command -v shasum >/dev/null 2>&1; then
    SOURCE_SHA="$(shasum -a 256 "$SINGBOX_SOURCE/common/tls/reality_client.go" | awk '{print $1}')"
  else
    SOURCE_SHA="$(sha256sum "$SINGBOX_SOURCE/common/tls/reality_client.go" | awk '{print $1}')"
  fi
  if [[ "$SOURCE_SHA" != "cb4fcbd0f76347282cd31e630271c02bb3c5273205b005f47987804e2adc4742" ]]; then
    echo "error: pinned REALITY source changed; refusing to apply an unaudited patch" >&2
    exit 1
  fi
  DNS_SOURCE="$SINGBOX_SOURCE/dns/transport/local/systemconfig/source_darwin.go"
  if command -v shasum >/dev/null 2>&1; then
    DNS_SOURCE_SHA="$(shasum -a 256 "$DNS_SOURCE" | awk '{print $1}')"
  else
    DNS_SOURCE_SHA="$(sha256sum "$DNS_SOURCE" | awk '{print $1}')"
  fi
  if [[ "$DNS_SOURCE_SHA" != "9a272357e282eb48d9d1e80a589fe0729c422c7d96cb792d3c2049a30704e104" ]]; then
    echo "error: pinned Darwin DNS source changed; re-audit sing-box-darwin-system-dns.patch" >&2
    exit 1
  fi
  mkdir -p "$ROOT/target"
  PATCH_DIR="$(mktemp -d "$ROOT/target/core-patches.XXXXXX")"
  trap 'rm -rf "$PATCH_DIR"' EXIT
  cp -R "$SINGBOX_SOURCE" "$PATCH_DIR/sing-box"
  chmod -R u+w "$PATCH_DIR/sing-box"
  patch --batch --fuzz=0 -d "$PATCH_DIR/sing-box" -p1 < "$CORE_DIR/patches/sing-box-reality-mlkem.patch"
  patch --batch --fuzz=0 -d "$PATCH_DIR/sing-box" -p1 < "$CORE_DIR/patches/sing-box-darwin-system-dns.patch"
  cp "$CORE_DIR/go.mod" "$PATCH_DIR/core.mod"
  cp "$CORE_DIR/go.sum" "$PATCH_DIR/core.sum"
  "$GO_BIN" mod edit -modfile="$PATCH_DIR/core.mod" \
    -replace="github.com/sagernet/sing-box=$PATCH_DIR/sing-box"
  LDFLAGS="-w -s -X 'internal/godebug.defaultGODEBUG=multipathtcp=0' -checklinkname=0"
  if [[ -n "$VERSION_SINGBOX" ]]; then
    LDFLAGS="-w -s -X 'github.com/sagernet/sing-box/constant.Version=${VERSION_SINGBOX}' -X 'internal/godebug.defaultGODEBUG=multipathtcp=0' -checklinkname=0"
  fi
  # shellcheck disable=SC2086
  extra_env=()
  if [[ "$(uname -s)" == "Darwin" ]]; then
    extra_env+=(CGO_ENABLED=1 CGO_LDFLAGS="-weak_framework UniformTypeIdentifiers")
  fi
  if [[ "${THRONE_CORE_VERIFY_PATCHES:-0}" == "1" ]]; then
    env "${extra_env[@]}" "$GO_BIN" test -race -count=1 -modfile="$PATCH_DIR/core.mod" -mod=readonly \
      -tags "$TAGS" -ldflags "-checklinkname=0" \
      github.com/sagernet/sing-box/dns/transport/local/systemconfig ./internal/sysdns ./internal/boxmain
  fi
  env "${extra_env[@]}" "$GO_BIN" build -modfile="$PATCH_DIR/core.mod" -mod=readonly -trimpath -tags "$TAGS" -ldflags "$LDFLAGS" -o "$OUT_BIN" .
)

# macOS: clear quarantine so setuid / Gatekeeper don't block
if [[ "$(uname -s)" == "Darwin" ]]; then
  xattr -d com.apple.quarantine "$OUT_BIN" 2>/dev/null || true
fi

echo "ok: $(ls -lh "$OUT_BIN" | awk '{print $5, $9}')"
echo "note: Tun needs root setuid on the core binary (GUI elevates on first Tun enable)"
